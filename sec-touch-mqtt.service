[Unit]
Description=SEC-Touch Lueftung <-> MQTT Bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/sec-touch/sec_touch_mqtt.py --config /etc/sec-touch-mqtt.conf
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
